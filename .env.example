# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Postgres ---
POSTGRES_USER=price_intel
POSTGRES_PASSWORD=change_me
POSTGRES_DB=price_intel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full URL overrides the five values above. The local no-Docker
# dev database (scripts/dev_db.py) prints one of these.
# DATABASE_URL=postgresql+psycopg://price_intel:change_me@localhost:5432/price_intel

# Hosted Postgres (Neon free tier). Use the DIRECT string for migrations and
# batch jobs; the pooled string is for high-concurrency servers. Environment
# variables override .env, so local dev can still point at scripts/dev_db.py.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Single shared login so the public EC2 box isn't an open scraper.
APP_USERNAME=admin
APP_PASSWORD=change_me
SECRET_KEY=change_me_to_a_long_random_string

# --- Email alerts (Resend or SendGrid) ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com

# --- MLflow (local file store) ---
MLFLOW_TRACKING_URI=./mlruns

# --- Scraping ---
# Hours between re-scrapes of each product; jitter and per-host rate limits
# are applied in code, not here.
SCRAPE_INTERVAL_HOURS=6
SCRAPE_USER_AGENT=

# --- Kaggle (used to build the feature pipeline before live data exists) ---
KAGGLE_USERNAME=
KAGGLE_KEY=